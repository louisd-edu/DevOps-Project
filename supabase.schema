-- WARNING: This schema is for context only and is not meant to be run.
-- Table order and constraints may not be valid for execution.

CREATE TABLE public.cuisines (
  name text NOT NULL UNIQUE,
  broader_areas ARRAY,
  CONSTRAINT cuisines_pkey PRIMARY KEY (name)
);
CREATE TABLE public.favorites (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  userid uuid,
  recipeid bigint NOT NULL,
  CONSTRAINT favorites_pkey PRIMARY KEY (id),
  CONSTRAINT favorite_recipeid_fkey FOREIGN KEY (recipeid) REFERENCES public.recipes(id),
  CONSTRAINT favorite_userid_fkey FOREIGN KEY (userid) REFERENCES auth.users(id)
);
CREATE TABLE public.ingredients (
  name text NOT NULL,
  calories bigint NOT NULL,
  protein bigint,
  CONSTRAINT ingredients_pkey PRIMARY KEY (name)
);
CREATE TABLE public.profiles (
  id uuid NOT NULL,
  updated_at timestamp with time zone,
  username text UNIQUE CHECK (char_length(username) >= 3),
  full_name text,
  avatar_url text,
  website text,
  level integer,
  displayname text,
  CONSTRAINT profiles_pkey PRIMARY KEY (id),
  CONSTRAINT profiles_id_fkey FOREIGN KEY (id) REFERENCES auth.users(id)
);
CREATE TABLE public.ratings (
  id bigint GENERATED ALWAYS AS IDENTITY NOT NULL,
  rating real NOT NULL CHECK (rating < 10::double precision),
  comment text,
  CONSTRAINT ratings_pkey PRIMARY KEY (id)
);
CREATE TABLE public.recipe_ingredients (
  id uuid NOT NULL DEFAULT gen_random_uuid() UNIQUE,
  recipeid bigint,
  ingredientid text,
  quantity integer,
  type USER-DEFINED,
  CONSTRAINT recipe_ingredients_pkey PRIMARY KEY (id),
  CONSTRAINT recipe_ingedrients_recipeid_fkey FOREIGN KEY (recipeid) REFERENCES public.recipes(id),
  CONSTRAINT recipe_ingredients_ingredientid_fkey FOREIGN KEY (ingredientid) REFERENCES public.ingredients(name)
);
CREATE TABLE public.recipes (
  id bigint GENERATED ALWAYS AS IDENTITY NOT NULL,
  user_id uuid NOT NULL,
  created_at timestamp with time zone NOT NULL DEFAULT now(),
  recipename text NOT NULL DEFAULT ''::text,
  recipeimageurl text,
  cuisine text,
  cookingtime integer,
  search_tsv tsvector DEFAULT to_tsvector('english'::regconfig, ((COALESCE(recipename, ''::text) || ' '::text) || COALESCE(cuisine, ''::text))),
  method ARRAY,
  total_calories bigint NOT NULL DEFAULT 0,
  total_protein bigint NOT NULL DEFAULT 0,
  CONSTRAINT recipes_pkey PRIMARY KEY (id),
  CONSTRAINT recipes_user_id_fkey FOREIGN KEY (user_id) REFERENCES auth.users(id),
  CONSTRAINT recipes_user_id_fkey1 FOREIGN KEY (user_id) REFERENCES public.profiles(id),
  CONSTRAINT recipes_cuisine_fkey FOREIGN KEY (cuisine) REFERENCES public.cuisines(name)
);
CREATE TABLE public.saved (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  userid uuid,
  recipeid bigint NOT NULL,
  CONSTRAINT saved_pkey PRIMARY KEY (id),
  CONSTRAINT saved_recipeid_fkey FOREIGN KEY (recipeid) REFERENCES public.recipes(id),
  CONSTRAINT saved_userid_fkey FOREIGN KEY (userid) REFERENCES auth.users(id)
);